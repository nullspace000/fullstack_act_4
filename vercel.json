{
  "version": 2,
  "framework": null,
  "buildCommand": "npm ci",
  "devCommand": "node server.js",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "functions": {
    "server.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "env": {
    "JWT_SECRET": "@jwt_secret",
    "PORT": "3000"
  }
}
